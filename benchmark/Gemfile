# frozen_string_literal: true

# Standalone bundle for the comparison benchmark (kept separate from the gem's
# own Gemfile so the gem gains no dev dependency on the other Sass engines).
source "https://rubygems.org"

# The published gem by default; SASSO_PATH=.. measures a working tree instead,
# which is how the main README's table is produced (a released number and an
# unreleased one are not comparable, and the default must stay reproducible).
if (sasso_path = ENV["SASSO_PATH"])
  gem "sasso", path: sasso_path   # this gem, built from source (in-process Rust)
else
  gem "sasso"                     # this gem (in-process Rust)
end
gem "sass-embedded"   # official dart-sass Ruby host (subprocess + IPC)
gem "sassc"           # libsass C binding (deprecated; reference only)
